# Copy to .env and adjust. docker compose reads .env automatically.

# --- Database -------------------------------------------------------------
AMP_DB_NAME=amp
AMP_DB_USER=amp
AMP_DB_PASSWORD=amp122006
# Host port for psql/pg_restore. Change if 5432 is already taken locally.
AMP_DB_PUBLISHED_PORT=5432

# --- Application ----------------------------------------------------------
# Host port for the webapp.
AMP_PUBLISHED_PORT=8080
# Must equal dg_site_domain in the database. After restoring a country dump:
#   UPDATE dg_site_domain SET site_domain = 'localhost';
AMP_SERVER_NAME=localhost
# Tomcat max heap. AMP is heavy; 4g is a workable floor, 8g is what the
# deployed servers use.
AMP_MAX_HEAP=4g

AMP_SMTP_HOST=ampdevde.aws.devgateway.org
AMP_SMTP_FROM=noreply@developmentgateway.org

# --- Build ----------------------------------------------------------------
# The Maven test suite needs a populated database, so it is skipped by
# default. Set to false to run `mvn test` during the image build.
AMP_SKIP_TESTS=true
AMP_BUILD_SOURCE=local
